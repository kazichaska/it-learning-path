# Copy to terraform.tfvars and adjust:  cp terraform.tfvars.example terraform.tfvars
# (terraform.tfvars is git-ignored because real projects often put sensitive values in it.)

region   = "us-east-1"
project  = "it-learning"
vpc_cidr = "10.0.0.0/16"
az_count = 2

# Find your public IP with: curl -s https://ifconfig.me
# allowed_ssh_cidr = "203.0.113.7/32"
